# Set the published image that contains your proxy support changes.
# Use latest, or pin the sha-<commit> tag for a specific release.
XIAOYA_EMD_IMAGE=ghcr.io/clowrain/xiaoya-emd:latest

# HTTP/mixed proxy on the NAS. URL-encode the username/password separately.
# Example: 'http://dockerproxy:URL_ENCODED_PASSWORD@127.0.0.1:7890'
XIAOYA_PROXY_URL=

# Refresh selected Emby libraries after a successful sync with downloaded files.
EMBY_REFRESH_ENABLED=true
EMBY_URL=http://127.0.0.1:2345/emby
# Host directory mounted as /data in the xiaoya container.
# The crawler reads infuse_api_key.txt from a read-only mount before each refresh.
XIAOYA_DATA_DIR=/vol1/1000/xiaoya

# Progress interval and per-request timeouts, in seconds.
PROGRESS_INTERVAL=15
CONNECT_TIMEOUT=15
READ_TIMEOUT=60
REQUEST_TIMEOUT=300
